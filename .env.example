# Environment template — copy to .env and fill in real values.
# NEVER commit the real .env (it's gitignored). NEVER reuse any value that
# was ever committed to this repo's git history — even after history was
# purged, treat every credential that was exposed as compromised and
# rotate it for real (new DB password, new secrets below, etc.).

# --- Database ---
DATABASE_URL="postgresql://user:password@host:5432/dbname"
PGSSLMODE=require
DB_SSL_MODE=require

# --- Server ---
PORT=9000
NODE_ENV=development
BASE_URL=http://localhost:9000
APP_URL=http://localhost:9000

# --- Vite (frontend dev server) ---
VITE_API_BASE_URL=localhost:9000
VITE_BASE_URL=http://localhost:9000
VITE_PORT=9000
VITE_DEV_SERVER_HOST_CHECK=false

# --- Initial admin account (used only on first boot / seed scripts) ---
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin@example.com
ADMIN_FULL_NAME="Super Admin"

# --- Session & encryption secrets ---
# Generate real values with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Do this once per environment (dev/staging/prod) — never share the same
# secret across environments, and never fall back to a hardcoded default.
SESSION_SECRET=
ENCRYPTION_KEY=

# Cookie security: only set true in a local dev environment served over
# plain HTTP. Must be unset/false in staging and production so session
# cookies are marked Secure.
FORCE_INSECURE_COOKIE=false

# --- License system (server/services/license-validator.ts) ---
# Required in production so license files can't be forged by anyone who
# has this source (see tasks/done/2026-08-31-fase1-broken-crypto-and-license.md).
LICENSE_ENCRYPTION_KEY=
LICENSE_SIGNING_SECRET=

# --- Security toggles ---
# DISABLE_CSP should be false (or unset) everywhere except a local dev box
# where a strict CSP gets in the way of the Vite dev server. Never true in
# staging/production — see tasks/PLAN.md Fase 3.
DISABLE_CSP=false
ENABLE_RUNTIME_PROTECTION=true
ENABLE_CLIENT_PROTECTION=true
ENABLE_CONSOLE_PROTECTION=false

LOG_LEVEL=INFO

# --- Third-party integrations (only what the platform itself calls with
# its own credentials — most channels are BYOK per-company, stored
# encrypted in the DB, not here) ---
GOOGLE_CLIENT_SECRET=
SUPER_ADMIN_EMAIL=

# Fallback Twilio/ElevenLabs credentials, used only for super-admin-level
# diagnostics when a company hasn't connected its own (see
# server/webhook-routes.ts). Leave empty unless you specifically need this.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SKIP_VERIFY=0

# System-level AI fallback keys (per-company keys take priority — see
# server/services/ai-credentials-service.ts)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
